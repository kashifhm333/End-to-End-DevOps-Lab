{
  "name": "devops-starter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DevOps Starter App - Production-grade full-stack monorepo",
  "scripts": {
    "dev:backend": "npm --prefix app/backend run dev",
    "dev:frontend": "npm --prefix app/frontend run dev",
    "start:backend": "npm --prefix app/backend run start",
    "build:frontend": "npm --prefix app/frontend run build",
    "test:backend": "npm --prefix app/backend test",
    "test:frontend": "npm --prefix app/frontend test",
    "test": "npm run test:backend && npm run test:frontend"
  }
}

